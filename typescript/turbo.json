{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "SWC_NATIVE_BINDING_CACHE"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate",
        "generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "CHAPCHOO_PUBLIC_URL"
      ],
      "passThroughEnv": [
        "CI",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SITE_GOOGLE_ANALYTICS_ID"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "passThroughEnv": [
        "CHAPCHOO_PUBLIC_URL",
        "CHAPCHOO_WEB_HOST",
        "CHAPCHOO_BACKEND_URL"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "^generate"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "cache": false
    },
    "format": {},
    "format:check": {},
    "typecheck": {
      "dependsOn": [
        "^build",
        "^generate"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
