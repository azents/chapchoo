{
  "name": "@chapchoo/design-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "build": "tsc --noEmit && node --test check-design.mjs check-mascot-motion.mjs",
    "check:design": "node --test check-design.mjs check-mascot-motion.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6008",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "typecheck": "tsc --noEmit && node --test check-design.mjs check-mascot-motion.mjs",
    "lint": "eslint src .storybook --max-warnings 0",
    "lint:fix": "eslint src .storybook --max-warnings 0 --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' '.storybook/**/*.{ts,tsx}' '*.mjs' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' '.storybook/**/*.{ts,tsx}' '*.mjs' '*.md'"
  },
  "dependencies": {
    "@chapchoo/ui": "workspace:*",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.5"
  }
}
