{
  "name": "@chapchoo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/stage-web-fonts.mjs web && next dev --webpack --hostname 127.0.0.1 --port 3003",
    "build": "node ../../scripts/stage-web-fonts.mjs web && next build --webpack",
    "start": "node server.mjs",
    "test": "node --experimental-strip-types --test 'src/**/*.test.mts'",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "lint": "eslint src .storybook --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "eslint src .storybook --max-warnings 0 --fix --cache --cache-strategy content",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --cache 'src/**/*.{ts,tsx,mts}' '.storybook/**/*.{ts,tsx}' 'messages/**/*.json'",
    "format:check": "prettier --check --cache 'src/**/*.{ts,tsx,mts}' '.storybook/**/*.{ts,tsx}' 'messages/**/*.json'",
    "test:components": "playwright test --config playwright-components.config.ts"
  },
  "dependencies": {
    "@chapchoo/ui": "workspace:*",
    "@chapchoo/web-core": "workspace:*",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "geist": "^1.7.2",
    "next": "16.4.1",
    "next-intl": "^4.13.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@next/eslint-plugin-next": "^16.3.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "@playwright/test": "1.64.1"
  }
}
