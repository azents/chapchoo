{
  "name": "@chapchoo/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "pnpm --filter @chapchoo/testenv... --filter @chapchoo/web-core... build && playwright test",
    "test:unit": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src playwright.config.ts --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' '*.ts' '*.mjs' 'package.json' '*.md'",
    "format:check": "prettier --check 'src/**/*.ts' '*.ts' '*.mjs' 'package.json' '*.md'"
  },
  "dependencies": {
    "@chapchoo/testenv": "workspace:*",
    "@chapchoo/web-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
