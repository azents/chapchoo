{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapchoo chart values",
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "publicUrl": {
          "type": "string"
        },
        "compiledBasePath": {
          "type": "string",
          "pattern": "^$|^/[^; %\\\\?#]+$"
        },
        "backendUrl": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      },
      "required": [
        "enabled",
        "replicas",
        "publicUrl",
        "compiledBasePath",
        "backendUrl",
        "image",
        "resources"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingTlsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "enabled",
        "host",
        "existingTlsSecret"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prerequisitesConfirmed": {
      "type": "boolean"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 43,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253,
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topology": {
          "enum": [
            "combined",
            "separate"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      },
      "required": [
        "enabled",
        "topology",
        "replicas",
        "image",
        "resources"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "urlKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "existingSecret",
        "urlKey"
      ]
    },
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "existingSecret",
        "key"
      ]
    },
    "setupProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "existingSecret",
        "key"
      ]
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      },
      "required": [
        "activeDeadlineSeconds",
        "resources"
      ]
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sender": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "existingCredentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "accessKeyIdKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "secretAccessKeyKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "enabled",
        "sender",
        "region",
        "existingCredentialsSecret",
        "accessKeyIdKey",
        "secretAccessKeyKey"
      ]
    },
    "general": {
      "$ref": "#/$defs/web"
    },
    "admin": {
      "$ref": "#/$defs/web"
    },
    "webIngress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controller": {
          "enum": [
            "ingress-nginx"
          ]
        },
        "className": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingTlsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "enabled",
        "controller",
        "className",
        "existingTlsSecret"
      ]
    },
    "grpcIngress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controller": {
          "enum": [
            "ingress-nginx"
          ]
        },
        "className": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "general": {
          "$ref": "#/$defs/route"
        },
        "admin": {
          "$ref": "#/$defs/route"
        }
      },
      "required": [
        "enabled",
        "controller",
        "className",
        "general",
        "admin"
      ]
    }
  },
  "required": [
    "prerequisitesConfirmed",
    "fullnameOverride",
    "imagePullSecrets",
    "terminationGracePeriodSeconds",
    "backend",
    "database",
    "secretKey",
    "setupProof",
    "prepare",
    "mail",
    "general",
    "admin",
    "webIngress",
    "grpcIngress"
  ]
}
