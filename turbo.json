{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "typescript/scripts/stage-web-fonts.mjs"
  ],
  "globalPassThroughEnv": [
    "SWC_NATIVE_BINDING_CACHE"
  ],
  "tasks": {
    "@chapchoo/design-reference#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/DESIGN.md"
      ],
      "outputs": []
    },
    "@chapchoo/design-reference#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/DESIGN.md"
      ]
    },
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate",
        "generate"
      ],
      "outputs": [
        "public/fonts/**",
        "public/design-assets/**",
        "public/favicon.ico",
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "passThroughEnv": [
        "CI"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "passThroughEnv": [
        "CHAPCHOO_PUBLIC_URL",
        "CHAPCHOO_WEB_HOST",
        "CHAPCHOO_BACKEND_URL"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "^generate"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "cache": false
    },
    "format": {},
    "format:check": {},
    "typecheck": {
      "dependsOn": [
        "^build",
        "^generate"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
